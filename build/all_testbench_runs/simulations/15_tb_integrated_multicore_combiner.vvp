TD_tb_integrated_multicore_combiner.check_case ;
    %vpi_call/w 3 78 "$display", "\012--- %0s ---", v0000011619BDA4F0_0 {0 0 0};
    %vpi_call/w 3 79 "$display", "core_enable=%b done=%b result_valid=%b", v0000011619CF9C30_0, v0000011619CFCD90_0, v0000011619CFDE70_0 {0 0 0};
    %vpi_call/w 3 81 "$display", "partial results: %0d, %0d, %0d, %0d", v0000011619CFC250_0, v0000011619CFCBB0_0, v0000011619CFCC50_0, v0000011619CFCF70_0 {0 0 0};
    %vpi_call/w 3 83 "$display", "combined final_result=%0d (expected %0d)", v0000011619CFC4D0_0, v0000011619BDA310_0 {0 0 0};
    %load/vec4 v0000011619CF9C30_0;
    %load/vec4 v0000011619BD9CD0_0;
    %cmp/ne;
    %jmp/0xz  T_0.0, 6;
    %vpi_call/w 3 87 "$display", "FAIL: unexpected active-core mask" {0 0 0};
    %load/vec4 v0000011619CFD1F0_0;
    %addi 1, 0, 32;
    %store/vec4 v0000011619CFD1F0_0, 0, 32;
    %jmp T_0.1;
T_0.0 ;
    %vpi_call/w 3 90 "$display", "PASS: active-core mask" {0 0 0};
T_0.1 ;
    %load/vec4 v0000011619CFCD90_0;
    %cmpi/ne 1, 0, 1;
    %jmp/1 T_0.4, 6;
    %flag_mov 8, 6;
    %load/vec4 v0000011619CFDE70_0;
    %cmpi/ne 1, 0, 1;
    %flag_or 6, 8;
T_0.4;
    %jmp/0xz  T_0.2, 6;
    %vpi_call/w 3 94 "$display", "FAIL: result_valid was not asserted at completion" {0 0 0};
    %load/vec4 v0000011619CFD1F0_0;
    %addi 1, 0, 32;
    %store/vec4 v0000011619CFD1F0_0, 0, 32;
    %jmp T_0.3;
T_0.2 ;
    %vpi_call/w 3 97 "$display", "PASS: completion and result_valid" {0 0 0};
T_0.3 ;
    %load/vec4 v0000011619CFC4D0_0;
    %load/vec4 v0000011619BDA310_0;
    %cmp/ne;
    %jmp/0xz  T_0.5, 6;
    %vpi_call/w 3 101 "$display", "FAIL: combined result incorrect" {0 0 0};
    %load/vec4 v0000011619CFD1F0_0;
    %addi 1, 0, 32;
    %store/vec4 v0000011619CFD1F0_0, 0, 32;
    %jmp T_0.6;
T_0.5 ;
    %vpi_call/w 3 104 "$display", "PASS: combined final result" {0 0 0};
T_0.6 ;
    %end;
