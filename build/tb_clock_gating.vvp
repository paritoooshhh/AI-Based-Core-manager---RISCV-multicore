#! /c/Source/iverilog-install/bin/vvp
:ivl_version "14.0 (devel)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "C:\iverilog\lib\ivl\system.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_sys.vpi";
:vpi_module "C:\iverilog\lib\ivl\vhdl_textio.vpi";
:vpi_module "C:\iverilog\lib\ivl\v2005_math.vpi";
:vpi_module "C:\iverilog\lib\ivl\va_math.vpi";
:vpi_module "C:\iverilog\lib\ivl\v2009.vpi";
S_00000255A270DF80 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_00000255A27AD570 .scope module, "tb_clock_gating" "tb_clock_gating" 3 6;
 .timescale -9 -12;
v00000255A270A0F0_0 .var/i "before_count", 31 0;
v00000255A270A230_0 .var "clk", 0 0;
v00000255A2709330_0 .var/i "disabled_rises", 31 0;
v00000255A2709E70_0 .var "enable", 0 0;
v00000255A27096F0_0 .var/i "failures", 31 0;
v00000255A2709A10_0 .net "gated_clk", 0 0, L_00000255A270BB50;  1 drivers
v00000255A2709790_0 .var/i "gated_rises", 31 0;
v00000255A2709830_0 .var/i "i", 31 0;
v00000255A27098D0_0 .var "reset", 0 0;
E_00000255A2AD4150 .event posedge, v00000255A2709470_0;
E_00000255A2ACE610 .event negedge, v00000255A2709470_0;
E_00000255A2ACE210 .event posedge, v00000255A2709510_0;
S_00000255A27AD700 .scope module, "dut" "clock_gating" 3 20, 4 481 0, S_00000255A27AD570;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "clk";
    .port_info 1 /INPUT 1 "reset";
    .port_info 2 /INPUT 1 "enable";
    .port_info 3 /OUTPUT 1 "gated_clk";
L_00000255A270BB50 .functor AND 1, v00000255A270A230_0, v00000255A270A050_0, C4<1>, C4<1>;
v00000255A2709470_0 .net "clk", 0 0, v00000255A270A230_0;  1 drivers
v00000255A270A190_0 .net "enable", 0 0, v00000255A2709E70_0;  1 drivers
v00000255A270A050_0 .var "enable_latched", 0 0;
v00000255A2709510_0 .net "gated_clk", 0 0, L_00000255A270BB50;  alias, 1 drivers
v00000255A2709970_0 .net "reset", 0 0, v00000255A27098D0_0;  1 drivers
E_00000255A2ACE250/0 .event negedge, v00000255A2709470_0;
E_00000255A2ACE250/1 .event posedge, v00000255A2709970_0;
E_00000255A2ACE250 .event/or E_00000255A2ACE250/0, E_00000255A2ACE250/1;
    .scope S_00000255A27AD700;
T_0 ;
    %wait E_00000255A2ACE250;
    %load/vec4 v00000255A2709970_0;
    %flag_set/vec4 8;
    %jmp/0xz  T_0.0, 8;
    %pushi/vec4 0, 0, 1;
    %assign/vec4 v00000255A270A050_0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/vec4 v00000255A270A190_0;
    %assign/vec4 v00000255A270A050_0, 0;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_00000255A27AD570;
T_1 ;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v00000255A270A230_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v00000255A27098D0_0, 0, 1;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v00000255A2709E70_0, 0, 1;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v00000255A2709790_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v00000255A27096F0_0, 0, 32;
    %end;
    .thread T_1, $init;
    .scope S_00000255A27AD570;
T_2 ;
    %delay 5000, 0;
    %load/vec4 v00000255A270A230_0;
    %inv;
    %store/vec4 v00000255A270A230_0, 0, 1;
    %jmp T_2;
    .thread T_2;
    .scope S_00000255A27AD570;
T_3 ;
    %wait E_00000255A2ACE210;
    %load/vec4 v00000255A2709790_0;
    %addi 1, 0, 32;
    %store/vec4 v00000255A2709790_0, 0, 32;
    %jmp T_3;
    .thread T_3;
    .scope S_00000255A27AD570;
T_4 ;
    %vpi_call/w 3 33 "$display", "\012=== CLOCK GATING DIAGNOSTICS ===" {0 0 0};
    %delay 2000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v00000255A27098D0_0, 0, 1;
    %delay 10000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v00000255A27098D0_0, 0, 1;
    %wait E_00000255A2AD4150;
    %delay 1000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v00000255A2709E70_0, 0, 1;
    %pushi/vec4 4, 0, 32;
T_4.0 %dup/vec4;
    %cmpi/s 0, 0, 32;
    %jmp/1xz T_4.1, 5;
    %jmp/1 T_4.1, 4;
    %subi 1, 0, 32;
    %wait E_00000255A2AD4150;
    %jmp T_4.0;
T_4.1 ;
    %pop/vec4 1;
    %delay 1000, 0;
    %load/vec4 v00000255A2709790_0;
    %store/vec4 v00000255A270A0F0_0, 0, 32;
    %load/vec4 v00000255A270A0F0_0;
    %cmpi/s 3, 0, 32;
    %jmp/0xz  T_4.2, 5;
    %vpi_call/w 3 54 "$display", "FAIL: enabled clock produced too few edges (%0d)", v00000255A270A0F0_0 {0 0 0};
    %load/vec4 v00000255A27096F0_0;
    %addi 1, 0, 32;
    %store/vec4 v00000255A27096F0_0, 0, 32;
    %jmp T_4.3;
T_4.2 ;
    %vpi_call/w 3 60 "$display", "PASS: enabled clock produces edges (%0d observed)", v00000255A270A0F0_0 {0 0 0};
T_4.3 ;
    %wait E_00000255A2AD4150;
    %delay 1000, 0;
    %pushi/vec4 0, 0, 1;
    %store/vec4 v00000255A2709E70_0, 0, 1;
    %wait E_00000255A2ACE610;
    %delay 1000, 0;
    %load/vec4 v00000255A2709790_0;
    %store/vec4 v00000255A270A0F0_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v00000255A2709330_0, 0, 32;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v00000255A2709830_0, 0, 32;
T_4.4 ; Top of for-loop
    %load/vec4 v00000255A2709830_0;
    %cmpi/s 5, 0, 32;
	  %jmp/0xz T_4.5, 5;
    %wait E_00000255A2AD4150;
    %delay 1000, 0;
    %load/vec4 v00000255A2709A10_0;
    %cmpi/e 1, 0, 1;
    %jmp/0xz  T_4.7, 6;
    %load/vec4 v00000255A2709330_0;
    %addi 1, 0, 32;
    %store/vec4 v00000255A2709330_0, 0, 32;
T_4.7 ;
T_4.6 ; for-loop step statement
    %load/vec4 v00000255A2709830_0;
    %addi 1, 0, 32;
    %store/vec4 v00000255A2709830_0, 0, 32;
    %jmp T_4.4;
T_4.5 ; for-loop exit label
    %load/vec4 v00000255A2709330_0;
    %cmpi/ne 0, 0, 32;
    %jmp/0xz  T_4.9, 4;
    %vpi_call/w 3 92 "$display", "FAIL: gated clock was high on %0d disabled observations", v00000255A2709330_0 {0 0 0};
    %load/vec4 v00000255A27096F0_0;
    %addi 1, 0, 32;
    %store/vec4 v00000255A27096F0_0, 0, 32;
    %jmp T_4.10;
T_4.9 ;
    %load/vec4 v00000255A2709790_0;
    %load/vec4 v00000255A270A0F0_0;
    %cmp/ne;
    %jmp/0xz  T_4.11, 4;
    %vpi_call/w 3 98 "$display", "FAIL: gated rising-edge count changed while disabled (%0d -> %0d)", v00000255A270A0F0_0, v00000255A2709790_0 {0 0 0};
    %load/vec4 v00000255A27096F0_0;
    %addi 1, 0, 32;
    %store/vec4 v00000255A27096F0_0, 0, 32;
    %jmp T_4.12;
T_4.11 ;
    %vpi_call/w 3 104 "$display", "PASS: gated clock remains stopped while disabled" {0 0 0};
T_4.12 ;
T_4.10 ;
    %wait E_00000255A2ACE610;
    %delay 1000, 0;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v00000255A2709E70_0, 0, 1;
    %pushi/vec4 3, 0, 32;
T_4.13 %dup/vec4;
    %cmpi/s 0, 0, 32;
    %jmp/1xz T_4.14, 5;
    %jmp/1 T_4.14, 4;
    %subi 1, 0, 32;
    %wait E_00000255A2AD4150;
    %jmp T_4.13;
T_4.14 ;
    %pop/vec4 1;
    %delay 1000, 0;
    %load/vec4 v00000255A2709790_0;
    %load/vec4 v00000255A270A0F0_0;
    %cmp/s;
    %flag_or 5, 4;
    %jmp/0xz  T_4.15, 5;
    %vpi_call/w 3 118 "$display", "FAIL: gated clock did not resume" {0 0 0};
    %load/vec4 v00000255A27096F0_0;
    %addi 1, 0, 32;
    %store/vec4 v00000255A27096F0_0, 0, 32;
    %jmp T_4.16;
T_4.15 ;
    %vpi_call/w 3 121 "$display", "PASS: gated clock resumes when re-enabled" {0 0 0};
T_4.16 ;
    %vpi_call/w 3 124 "$display", "----------------------------------------" {0 0 0};
    %vpi_call/w 3 125 "$display", "SUMMARY: failures=%0d", v00000255A27096F0_0 {0 0 0};
    %load/vec4 v00000255A27096F0_0;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_4.17, 4;
    %vpi_call/w 3 128 "$display", "RESULT: PASS" {0 0 0};
    %jmp T_4.18;
T_4.17 ;
    %vpi_call/w 3 130 "$display", "RESULT: FAIL" {0 0 0};
T_4.18 ;
    %vpi_call/w 3 132 "$finish" {0 0 0};
    %end;
    .thread T_4;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    ".\tb\tb_clock_gating.v";
    ".\rtl\14_Multicore-Zeta_corrected.v";
